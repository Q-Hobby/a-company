{
  "name": "@acompany/desktop",
  "productName": "A-Company",
  "description": "Self-hosted AI teammates with a built-in local workspace, Lite CLI, and Docker/server options.",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "dev:standalone": "pnpm --filter @acompany/db generate && cross-env ACOMPANY_ALLOW_DEV_SECRETS=1 pnpm --filter @acompany/web build && pnpm build && cross-env ACOMPANY_EMBEDDED_MODE=1 electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs && node scripts/bundle-embedded-api.mjs",
    "pack": "pnpm --filter @acompany/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:win": "pnpm --filter @acompany/db generate && cross-env ACOMPANY_ALLOW_DEV_SECRETS=1 pnpm --filter @acompany/web build && pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never -c.win.verifyUpdateCodeSignature=false",
    "pack:zip": "pnpm --filter @acompany/db generate && cross-env ACOMPANY_ALLOW_DEV_SECRETS=1 pnpm --filter @acompany/web build && pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.portable.cjs --win --x64 --publish never",
    "pack:dir": "pnpm --filter @acompany/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @acompany/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@acompany/contracts": "workspace:*",
    "@electric-sql/pglite": "0.5.16",
    "electron-updater": "6.8.9",
    "koffi": "3.2.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@acompany/api": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@acompany/ui-tokens": "workspace:*",
    "@playwright/test": "1.63.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.acompany.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@electric-sql/pglite/**/*",
      "**/node_modules/koffi/**/*",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../packages/db/prisma/migrations",
        "to": "migrations"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "../../packages/ui-tokens/assets/ACompany.icon",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "executableName": "acompany",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "phuocka",
        "repo": "a-company"
      }
    ]
  }
}
